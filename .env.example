# Postgres connection string (Neon, Supabase, or any Postgres).
# Leave unset for local development: the app then uses an embedded Postgres
# database in .data/pglite. Production (e.g. Neon on Vercel) requires this variable.
DATABASE_URL=

# Admin access key string.
# If set, this master password key unlocks the admin controls directly (no first-run setup required).
# If unset, the first visit will prompt you to set the admin key string in the database.
ADMIN_PASSWORD=
